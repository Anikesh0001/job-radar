# Create a bot with @BotFather on Telegram, then add it to your channel as admin.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# For a channel use @yourchannelname; for a private chat use the numeric id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=@my_job_alerts

# Optional
DISCORD_WEBHOOK_URL=

# Optional: unlocks the `adzuna` source, which is the legitimate route to
# Naukri/Indeed-class listings. Free key from https://developer.adzuna.com/
# Without these the adapter skips itself and says so in --health.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
