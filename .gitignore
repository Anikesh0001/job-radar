__pycache__/
*.pyc
.env
.venv/

# Generated data. None of this is committed — the scheduled workflow keeps the
# database and the spreadsheet as assets on the `data` release instead, so the
# git history stays flat instead of growing by ~5GB a year. Download the latest
# from  https://github.com/Anikesh0001/job-radar/releases/tag/data
jobs.db
jobs.db.gz
jobs.xlsx
jobs.csv
jobs.txt
latest.md

# LibreOffice lock file, created when you have the sheet open
.~lock.*#

# Your resume and everything derived from it. This repo is PUBLIC: a CV
# carries your phone number, email and address, and once pushed it lives in
# the git history and in every clone, whether or not you delete it later.
# Leading slash matters: an unanchored `resume.*` also swallowed src/resume.py,
# the parser itself, and it vanished from git without a word.
/resume.*
/cv.*
/profile.yaml
/applications.db
/applications.csv
/cover-letters/

# The apply layer stays on your machine. It reads your CV, holds your answers
# and drives a browser as you — none of which belongs in a public repo, and
# none of which CI could run anyway.
/apply.py
/APPLYING.md
/src/resume.py
/src/match.py
/src/letters.py
/src/apply_forms.py
/src/autofill.py
